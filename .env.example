# Copy this file to `.env` (gitignored) and fill in real values.
# docker-compose.yml loads this via `env_file: .env`.

# Govee Developer API key - request it in the Govee Home app:
# Profile -> Settings/About Us -> "Apply for API Key" (approval can take
# ~2 business days). Only needed as a fallback when a Govee light doesn't
# support LAN control or LAN control fails. See SETUP.md.
GOVEE_API_KEY=

# Tuya IoT Platform Cloud Project credentials (Access ID / Access Secret).
# Only needed as a fallback when local control (tinytuya) fails or a
# device's local_key/ip isn't configured yet. See SETUP.md.
TUYA_ACCESS_ID=
TUYA_ACCESS_KEY=

# Admin API token for /rooms, /clients, /rooms/validate and /rooms/reload
# (sent as "Authorization: Bearer <token>"). At least 16 characters, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Unset or
# shorter means those routes answer 503. Never reuse a Govee/Tuya key.
ADMIN_API_TOKEN=
