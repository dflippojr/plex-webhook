# Copy this file to `config/rooms.yaml` (gitignored) and fill in real
# values. rooms.yaml holds Plex client UUIDs and device ids, so it is
# not committed to this public repo.
#
# Discover the exact client identifiers Plex sends by hitting GET /clients
# on this service after playing something on the device you want to map -
# it lists every distinct Player title/uuid seen in captured events.
#
# Matching: a client is matched by uuid if given (stable across renames),
# otherwise by title (case-insensitive exact match).
#
# Per-device secrets (Tuya local_key/ip, or a pinned Govee LAN ip) live
# in config/devices.secrets.yaml (also gitignored - see
# config/devices.secrets.yaml.example) keyed by this same light `id`.
#
# Optional `model` field (Govee only): the device SKU (e.g. "H6159"),
# found in the Govee Home app under the device's settings. Only needed
# for Govee Cloud API fallback control - not required for LAN control.

rooms:
  living_room:
    name: "Living Room"
    plex_clients:
      - title: "TODO: e.g. Living Room Apple TV"
        uuid: null
    lights:
      - brand: govee   # govee | tuya
        id: "TODO-device-id"
        name: "TODO-light-name"
        model: "TODO-govee-sku"   # optional, e.g. "H6159" - cloud fallback only

  bedroom:
    name: "Bedroom"
    plex_clients:
      - title: "TODO: e.g. Google TV"
        uuid: null
    lights:
      - brand: tuya
        id: "TODO-device-id"
        name: "TODO-light-name"
