# Copy this file to `config/devices.secrets.yaml` (gitignored - never commit
# the real file, it contains local-network credentials) and fill in real
# values as you gather them. Keyed by the same `id` used in rooms.yaml.
#
# Tuya/Gosund devices: id/local_key/ip come from running
#   python -m tinytuya wizard
# after linking your Smart Life/Tuya Smart app account to a Tuya IoT
# Platform Cloud Project. See SETUP.md for the full walkthrough. The wizard
# writes a devices.json with entries like:
#   {"id": "...", "key": "...", "ip": "...", "name": "..."}
# Transcribe "id" -> id (below), "key" -> local_key, "ip" -> ip.
#
# Govee devices: local control normally works via LAN auto-discovery and
# does not need an entry here. Only add one if discovery is unreliable on
# your network (e.g. multicast blocked by VLAN/AP isolation) and you want
# to pin a static IP instead - set a DHCP reservation for the bulb first.

devices:
  # Tuya example
  "TODO-device-id-tuya":
    local_key: "TODO-local-key-from-tinytuya-wizard"
    ip: "TODO-device-lan-ip"

  # Govee example (optional, only if LAN auto-discovery doesn't work)
  "TODO-device-id-govee":
    ip: "TODO-device-lan-ip"
