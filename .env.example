# Copy this file to `.env` (gitignored) and fill in real values.
# docker-compose.yml loads this via `env_file: .env`.

# Govee Developer API key - request it in the Govee Home app:
# Profile -> Settings/About Us -> "Apply for API Key" (approval can take
# ~2 business days). Only needed as a fallback when a Govee light doesn't
# support LAN control or LAN control fails. See SETUP.md.
GOVEE_API_KEY=

# Tuya IoT Platform Cloud Project credentials (Access ID / Access Secret).
# Only needed as a fallback when local control (tinytuya) fails or a
# device's local_key/ip isn't configured yet. See SETUP.md.
TUYA_ACCESS_ID=
TUYA_ACCESS_KEY=

# Home Assistant hub, for lights with `brand: hass` in rooms.yaml. HASS_URL is
# the hub's base URL as the container reaches it (http or https, no path query
# or fragment), e.g. http://<hub-address>:8123. HASS_TOKEN is a
# long-lived access token from your Home Assistant profile page. Both unset (or
# a URL that is not http(s)) skips every hass light. See SETUP.md.
HASS_URL=
HASS_TOKEN=

# Admin API token for /rooms, /clients, /rooms/validate and /rooms/reload
# (sent as "Authorization: Bearer <token>"). At least 16 characters, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Unset or
# shorter means those routes answer 503. Never reuse a Govee/Tuya key.
ADMIN_API_TOKEN=

# Webhook URL token. When set, Plex must post to
# http://127.0.0.1:9800/webhook/<WEBHOOK_TOKEN>; any other webhook request gets
# 404 and is not stored. At least 32 characters from A-Z a-z 0-9 - _ . ~, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`; a shorter
# value stops the service at startup. Unset keeps the unauthenticated
# POST /webhook and logs a warning. Never reuse ADMIN_API_TOKEN here.
WEBHOOK_TOKEN=
